# Copy to .env (never commit it). Nothing here is required to run Landing.

# --- Server (npm start) ---------------------------------------------------------------
PORT=8787
# Where city datasets are read from. Point this at a persistent volume in production so a data refresh
# does not require a rebuild.
DATA_DIR=public/data
# Built app directory (output of npm run build).
DIST_DIR=dist
# Address lookups allowed per client IP per minute (U.S. Census Bureau geocoder proxy).
GEOCODE_PER_MINUTE=20

# --- Ingestion (npm run ingest) -------------------------------------------------------
# A contact the open-data publishers can reach, sent in the User-Agent. Set this before scheduling refreshes.
INGEST_CONTACT=you@example.org
# Optional Socrata app token (data.cityofchicago.org, data.cityofnewyork.us, data.sfgov.org,
# data.austintexas.gov). Raises rate limits; used only by the ingestion scripts, never sent to browsers.
SOCRATA_APP_TOKEN=

# --- Sponsorship slot (build time, optional) ------------------------------------------
# A single labelled "Sponsored" message at the foot of neighborhood pages. Leave empty for none.
# It never affects rankings or rental links and receives no user inputs.
VITE_SPONSOR_NAME=
VITE_SPONSOR_TEXT=
VITE_SPONSOR_URL=
